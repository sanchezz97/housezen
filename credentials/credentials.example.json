{
  "name": "Plantilla de Credenciales",
  "description": "Este archivo es una plantilla. NUNCA subir credenciales reales a GitHub.",
  "credentials": {
    "api_example": {
      "type": "httpHeaderAuth",
      "name": "API Service Name",
      "data": {
        "name": "Authorization",
        "value": "Bearer YOUR_API_KEY_HERE"
      }
    },
    "oauth_example": {
      "type": "oAuth2Api",
      "name": "OAuth Service Name",
      "data": {
        "clientId": "YOUR_CLIENT_ID",
        "clientSecret": "YOUR_CLIENT_SECRET",
        "authUrl": "https://api.example.com/oauth/authorize",
        "accessTokenUrl": "https://api.example.com/oauth/token",
        "scope": "read write"
      }
    },
    "database_example": {
      "type": "postgres",
      "name": "PostgreSQL Connection",
      "data": {
        "host": "localhost",
        "database": "your_database",
        "user": "your_user",
        "password": "YOUR_PASSWORD",
        "port": 5432
      }
    },
    "email_example": {
      "type": "smtp",
      "name": "Email SMTP",
      "data": {
        "host": "smtp.gmail.com",
        "port": 587,
        "secure": false,
        "user": "your-email@gmail.com",
        "password": "YOUR_APP_PASSWORD"
      }
    }
  },
  "notes": [
    "Cada desarrollador debe configurar sus propias credenciales en n8n localmente",
    "Las credenciales se almacenan en el volumen Docker de n8n, no en este archivo",
    "Este archivo es solo referencia de qué credenciales necesitas configurar",
    "Para producción, usar variables de entorno o servicios de secrets management"
  ]
}
