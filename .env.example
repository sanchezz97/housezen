# Configuración de n8n
# Copia este archivo como .env y completa con tus valores

# Credenciales de acceso a n8n
N8N_USER=admin
N8N_PASSWORD=cambiar_por_password_seguro

# Host y configuración
N8N_HOST=localhost
WEBHOOK_URL=http://localhost:5678/

# Zona horaria
TIMEZONE=America/Mexico_City

# PostgreSQL (descomenta si usas PostgreSQL)
# POSTGRES_USER=n8n
# POSTGRES_PASSWORD=cambiar_por_password_seguro
# POSTGRES_DB=n8n
# DB_TYPE=postgresdb
# DB_POSTGRESDB_HOST=postgres
# DB_POSTGRESDB_PORT=5432
# DB_POSTGRESDB_DATABASE=n8n
# DB_POSTGRESDB_USER=n8n
# DB_POSTGRESDB_PASSWORD=cambiar_por_password_seguro
